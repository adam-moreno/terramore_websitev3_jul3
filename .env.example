# Copy to .env.local for development. Set the same names in the production host (Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# --- Supabase (required for both forms to save leads) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# "public" (default) or "website" if the tables were created with supabase-website-migration.sql
SUPABASE_SCHEMA=public

# --- Alerts to Adam, posted by the "Hearth" Slack app (App ID A0BQBDF5F8X, workspace Terramore.io) ---
# Mode A (preferred when present): bot token with the chat:write scope + the channel to post in (id or #name)
SLACK_BOT_TOKEN=
SLACK_LEADS_CHANNEL=
# Mode B (fallback, the scope Hearth has today): Incoming Webhook URL from the app's "Incoming Webhooks" page
SLACK_WEBHOOK_URL=

# --- Email: set ONE provider. Used for the report PDF, user confirmations, and the copy to Adam ---
RESEND_API_KEY=
# SENDGRID_API_KEY=
# POSTMARK_SERVER_TOKEN=
# Sender on a domain verified at the provider. RESEND_FROM_EMAIL is the Terra IQ dashboard's name for the same
# value and is read first, so one address can be shared across both projects; EMAIL_FROM is the fallback.
RESEND_FROM_EMAIL="Terramore <reports@terramore.io>"
# EMAIL_FROM=
# Admin copy. Defaults to adam.moreno@terramore.io when empty
NOTIFY_EMAIL_TO=adam.moreno@terramore.io
# Reply-To on every outbound email (confirmations, booking, the report). Defaults to adam.moreno@terramore.io
EMAIL_REPLY_TO=adam.moreno@terramore.io

# --- Booking (the /book page and the Schedule popup call Terra IQ; the secret stays on the server) ---
# Terra IQ origin. Defaults to https://dashboard.terramore.io
BOOKING_API_URL=https://dashboard.terramore.io
# Same value as BOOKING_API_SECRET on the Terra IQ Vercel project (openssl rand -hex 32). Empty = booking shows the fallback note
BOOKING_API_SECRET=

# --- Search Console. The Vercel project has this under the misspelled name GOOGLE_SITE_VERIFICAITON; both are read ---
GOOGLE_SITE_VERIFICATION=

# --- SMS confirmation to the requester (when they leave a phone) ---
# Prefer Sendblue when all three are set; otherwise Twilio. Either path fails soft (never breaks booking).
# Free Sendblue shared-line: create contact + recipient must text your line once before outbound works.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
# Fallback if Sendblue is not fully configured:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Digital Footprint report: set ONE model key. Override the model id with REPORT_MODEL ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REPORT_MODEL=gpt-4.1-mini
# Optional: Google Maps listing check (Places API (New), Text Search)
GOOGLE_PLACES_API_KEY=
# Long random string. Guards GET/POST /api/report/generate (config check and manual re-run)
REPORT_GENERATE_SECRET=

# --- Analytics / ads (client-visible NEXT_PUBLIC_*) ---
# GA4 is hardcoded in app/layout.tsx as G-BQN6VCY579 (do not change without updating layout).
# Google Ads conversion "Digital Footprint Report Submitted" — fires only after server 201 on /api/report.
# Defaults match the live Ads account if unset; set these in Vercel Production for clarity.
# NEXT_PUBLIC_GOOGLE_ADS_ID is preferred; NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID is an accepted alias.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-11353847408
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-11353847408
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=XnBzCIeStfgcEPDs96Uq
# Meta / TikTok — leave empty for launch. Scripts load only when set; Lead helpers fire on report success.
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Lead nurture cron (3 follow-up emails after Talk / report / book). Required in production. ---
# Vercel Cron sends Authorization: Bearer ${CRON_SECRET} automatically when this is set.
# Manual: GET/POST /api/cron/nurture with the same Bearer header or ?secret=
CRON_SECRET=
# Optional override for unsubscribe link HMAC (falls back to BOOKING_API_SECRET, then CRON_SECRET)
# NURTURE_SECRET=
